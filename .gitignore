# Conditional analysis code is published; generated analyses are local.
MIA_on_dataset/analysis/**
!MIA_on_dataset/analysis/
!MIA_on_dataset/analysis/*.py
!MIA_on_dataset/analysis/*.sh

# Publish only the acoustic feature tables and small metadata summaries from
# local dataset workspaces. Audio and dataset manifests are exported to HF.
MIA_on_dataset/data/**
!MIA_on_dataset/data/
